<?xml version="1.0" encoding="UTF-8"?>
<!--
  helix: public/sitemap.xml
  @helix:story USER-915000

  Static sitemap for the Helix landing site. The App Router also
  exposes a dynamic `app/sitemap.ts` route at `/sitemap.xml`, which
  takes precedence at runtime. This file is committed as a
  crawl-friendly fallback so that:

    • Static crawlers and link-checkers that hit `/sitemap.xml`
      directly see a valid XML document even before the Next.js
      server has booted.
    • The Vercel edge cache can serve the file verbatim from
      `public/` without invoking a server function.
    • Local preview environments (`npm run start`) without an env
      override still expose a sensible default URL.

  The canonical URL is sourced from `lib/brand.ts` (`brand.url`)
  and can be overridden at runtime via `NEXT_PUBLIC_BRAND_URL`.

  When the App Router sitemap is active, search engines should
  prefer it. This file is intentionally minimal and mirrors the
  same single-URL surface as `app/sitemap.ts`.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <url>
    <loc>https://helix-ai-orchestrator.vercel.app/</loc>
    <lastmod>2026-09-07</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link
      rel="alternate"
      hreflang="en-US"
      href="https://helix-ai-orchestrator.vercel.app/"
    />
  </url>
</urlset>