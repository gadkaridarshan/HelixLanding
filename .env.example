# Helix Landing — example environment variables.
# Copy this file to `.env.local` and fill in the values below for local development.
# All variables prefixed with `NEXT_PUBLIC_` are exposed to the browser bundle.

# Canonical production URL used by metadata, OG cards, and the footer hostname.
# Defaults to the reference demo if unset. Override with your own deployed domain
# (e.g. https://helix.example.com). Do not include a trailing slash.
NEXT_PUBLIC_BRAND_URL=https://helix-ai-orchestrator.vercel.app